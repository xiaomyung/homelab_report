#!/usr/bin/env bash
# tg-alert — send a one-off plain-text Telegram message using this repo's .env.
#
# The daily digest is report.sh; this is for event-driven alerts from other
# host scripts (watchdogs, guards, hooks) so every Telegram message from the
# server goes through one bot config in one place.
#
# Usage:
#   sudo tools/tg-alert "message text"
#   echo "message text" | sudo tools/tg-alert
#
# Callers should invoke it by its full path inside the repo (or via a symlink —
# .env is located next to the real script, not the link).
#
# Retries for ~1 minute, so it also works from boot-time units that run
# before the network or DNS is fully up.
#
# Exit codes: 0 sent · 1 usage/config error · 2 Telegram unreachable or rejected

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/../.env"

if [[ $# -gt 0 ]]; then
  TEXT="$*"
else
  TEXT="$(cat)"
fi
if [[ -z "${TEXT//[[:space:]]/}" ]]; then
  echo "tg-alert: empty message" >&2
  exit 1
fi

if [[ ! -r "$ENV_FILE" ]]; then
  echo "tg-alert: cannot read ${ENV_FILE} (missing, or not running as root)" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$ENV_FILE"
if [[ -z "${TG_BOT_TOKEN:-}" || -z "${TG_CHAT_ID:-}" ]]; then
  echo "tg-alert: TG_BOT_TOKEN / TG_CHAT_ID not set in ${ENV_FILE}" >&2
  exit 1
fi

# Telegram rejects messages over 4096 characters.
TEXT="${TEXT:0:4096}"

status=$(curl -s -o /dev/null -w "%{http_code}" \
  --max-time 20 --retry 6 --retry-delay 10 --retry-all-errors \
  --data-urlencode "chat_id=${TG_CHAT_ID}" \
  --data-urlencode "text=${TEXT}" \
  "https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage") || status="curl-failed"

if [[ "$status" != "200" ]]; then
  echo "tg-alert: sendMessage failed (${status})" >&2
  exit 2
fi
